@inproceedings{jeffay1991nonpreemptive,
  author    = {Jeffay, Kevin and Stanat, Donald F. and Martel, Charles U.},
  title     = {On Non-Preemptive Scheduling of Periodic and Sporadic Tasks},
  booktitle = {Proceedings of the 12th IEEE Real-Time Systems Symposium (RTSS 1991)},
  pages     = {129--139},
  year      = {1991},
  doi       = {10.1109/REAL.1991.160366},
  x-verified = {Verified 2026-09-20 and read in full text from the first author's copy. Theorem 4.1 gives necessary and sufficient conditions for non-preemptive uniprocessor scheduling without inserted idle time, the second of which requires every interval L between two periods to satisfy L >= c_i + sum of the interference from higher-rate tasks. The cost of non-preemption enters as the candidate task's own whole execution c_i. The word ``blocking'' does not occur in the paper and there is no ``maximum job length over lower-priority tasks'' term; the blocking-factor formulation B_i = max_{j>i} c_j belongs to the later fixed-priority literature and must not be attributed here. Crossref, DBLP and IEEE Xplore all print the title with ``period'' for ``Periodic''; that is a defect in IEEE's deposit and the printed title is as given here}
}

