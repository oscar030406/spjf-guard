  number  = {2},
  pages   = {1--33},
  year    = {2024},
  doi     = {10.1145/3656011},
  note    = {Preprint arXiv:2404.08826},
  x-verified = {Verified 2026-09-20 through the Crossref REST API (two authors, POMACS 8(2), pages 1--33, published 2024-05-21) and read in the arXiv v2 full text. Definition 3.2 defines the crossing work V(u) of a tagged job as the work of jobs arriving in (0,u) whose boosted arrival time is at most 0; Lemma 3.3 bounds the tagged job's response time under Boost and under Cheat from below by W - B + V(W) + S and from above by (W - min(B,u))^+ + V(infinity) + S + Vbar(u) 1(W < min(B,u)), where W is the stationary work in system at the boosted arrival instant, B the boost and S the size. Remark 3.4 states that the proof holds for preemptive, non-preemptive and intermediate Boost. Single server, Poisson arrivals, light-tailed sizes, no bound on service times; the reference term is a stationary workload variable and not the same job's FCFS wait on the same input}
}

@article{yu2025twotraffics,
  author  = {Yu, George and Harlev, Amit and Adakroy, Reevu and Scully, Ziv},
  title   = {A Tale of Two Traffics: Optimizing Tail Latency in the Light-Tailed {M/G/k}},
  journal = {Proceedings of the ACM on Measurement and Analysis of Computing Systems},
  volume  = {9},
  number  = {3},
  pages   = {1--40},
  year    = {2025},
  doi     = {10.1145/3771561},
  x-verified = {Verified 2026-09-20 through the Crossref REST API (four authors, POMACS 9(3), pages 1--40, December 2025) and read in the authors' PDF at https://ziv.codes/pdf/sigmetrics2026-yu.pdf, which prints Article 46. No arXiv version was found. Notation 3.2 carries crossing work to k servers of speed 1/k; Lemma 3.4 bounds the tagged job's response time by W - min(B,u) + kS + V(infinity) on the event that at least k older jobs are present at its arrival, and by k(S + V(infinity) + Vbar(min(B,u))) otherwise, the second branch being where a non-preemptive server already running a lower-priority job enters. Section 2 states that the proofs apply to preemptive and non-preemptive boost policies and that the simulations use the non-preemptive version. FCFS is the empirical baseline throughout: the paper reports a tail improvement ratio against FCFS, finds that gamma-Boost can be worse than FCFS at lighter loads, and designs gamma-CombinedBoost to repair that. The theorems compare tail constants, not per-job waits. SIGMETRICS 2026 abstract version doi:10.1145/3801489.3806888}
}

